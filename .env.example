# ==============================================================================
# Aaroh — Personal Career Intelligence Platform
# Environment Configuration Template (v1.0)
# ==============================================================================
# Aaroh is designed local-first and fully functional offline out-of-the-box.
# By default, Aaroh uses its grounded local semantic reasoning engine with
# zero external API keys required.
#
# If you wish to enable live cloud LLM responses in the AI Mentor (/mentor),
# provide ONE of the optional API keys below.
# ==============================================================================

# Google Gemini API Key (Optional)
# If provided, Aaroh connects to Gemini 1.5 Flash for open-ended queries.
# Get a key at: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional)
# If provided and GEMINI_API_KEY is not set, Aaroh connects to GPT-4o Mini.
# Get a key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Runtime Node Environment
NODE_ENV=development
