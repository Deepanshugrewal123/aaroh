{
  "name": "aaroh",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/__tests__/ai-evaluation-suite.test.ts",
    "test:benchmark": "vitest run src/__tests__/ai-evaluation-suite.test.ts",
    "test:e2e": "node scripts/e2e-browser-test.mjs",
    "test:e2e:chromium": "node scripts/e2e-browser-test.mjs --browser=chromium",
    "test:e2e:firefox": "node scripts/e2e-browser-test.mjs --browser=firefox",
    "test:e2e:webkit": "node scripts/e2e-browser-test.mjs --browser=webkit",
    "test:e2e:all": "node scripts/e2e-browser-test.mjs --browser=all",
    "audit:prod": "npm audit --omit=dev",
    "audit:dev": "npm audit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && npm run audit:prod"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.7"
  }
}
